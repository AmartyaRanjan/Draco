# Application-side inference settings (copy lines into .env). No real secrets here.
INFERENCE_BASE_URL=http://127.0.0.1:18001/v1
INFERENCE_API_KEY=<same as deploy/vllm/.env>
INFERENCE_MODEL=Qwen/Qwen3-4B-FP8
INFERENCE_MAX_MODEL_LEN=8192
INFERENCE_MAX_OUTPUT_TOKENS=1000
INFERENCE_TIMEOUT_S=90
INFERENCE_MAX_RETRIES=1
AGENT_MAX_STEPS=4
AGENT_MAX_TOOL_CALLS=4
AGENT_WORKFLOW_TOKEN_BUDGET=3000
# key:user[:scopes][:expires=YYYY-MM-DD], comma separated. Scopes (joined by +): read, chat, agent, upload, admin.
# A plain key:user may do everything except admin. Example: k1:alice:read+chat:expires=2027-01-31
APP_API_KEYS=<key>:<user_id>,<key2>:<user_id2>:read+chat:expires=2027-01-31
# APP_AUTH_DISABLED=true   # development only

# --- long-term memory (default off). hybrid = Qdrant dense + OpenSearch BM25, RRF fused, strictly per user ---
# MEMORY_BACKEND=hybrid
# MEMORY_QDRANT_COLLECTION=rag_user_memory
# MEMORY_OPENSEARCH_INDEX=rag_user_memory

# --- rolling conversation summary (default off) ---
# INFERENCE_SUMMARY_ENABLED=true
# INFERENCE_SUMMARY_TRIGGER_TOKENS=1600
# INFERENCE_SUMMARY_MAX_TOKENS=300
# INFERENCE_SUMMARY_INPUT_TOKENS=2500

# --- query rewriting for /chat retrieval: rules (default) | llm | off ---
# QUERY_REWRITE_MODE=rules
# QUERY_REWRITE_TIMEOUT_S=5
# QUERY_REWRITE_MAX_TOKENS=64

# --- retention (scripts/agent_maintenance.py; 0 keeps forever) ---
# CONVERSATION_RETENTION_DAYS=90
# AGENT_STATE_RETENTION_DAYS=30
