{"id": "cap-calc", "input": {"a": 3, "b": 4}, "require": ["calc"], "expect_path": ["math"], "expect_status": "completed"}
{"id": "cap-least-extra", "input": "x", "require": ["write"], "expect_path": ["writer"], "expect_status": "completed"}
{"id": "handoff-chain", "input": "2+3", "agent": "triage", "expect_path": ["triage", "math"], "expect_status": "completed"}
{"id": "unknown-agent", "input": "x", "agent": "ghost", "expect_status": "failed", "expect_error": "routing"}
{"id": "no-route", "input": "x", "require": ["teleport"], "expect_status": "failed", "expect_error": "routing"}
{"id": "bad-handoff", "input": "x", "agent": "bad", "expect_status": "failed", "expect_error": "routing"}
{"id": "loop", "input": "x", "agent": "ping", "expect_status": "failed", "expect_error": "routing"}
