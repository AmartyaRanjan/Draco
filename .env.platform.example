# HTTP platform layer (rate limits, auth lockout, body caps, CORS, observability). Copy lines into .env.
APP_ENV=development                 # production refuses: APP_AUTH_DISABLED, CORS_ORIGINS=*, RATE_LIMIT_ENABLED=false
LOG_LEVEL=INFO
LOG_JSON=true                       # one JSON object per line, with request_id
CORS_ORIGINS=                       # comma-separated explicit origins; empty = CORS off
TRUSTED_PROXY_HOPS=0                # >0 only behind your own proxies
TRUSTED_PROXY_CIDRS=                # required with hops: comma-separated proxy networks, e.g. 10.0.0.0/8
MAX_BODY_BYTES=1048576              # every route except uploads
MAX_UPLOAD_BYTES=105906176          # POST /documents (101 MiB; the route enforces 100 MiB of file)

RATE_LIMIT_ENABLED=true
# '<requests per minute>,<burst>' per authenticated user; Redis-backed (REDIS_URL), per-process fallback if Redis is down
RATE_LIMIT_HEAVY=20,6               # /chat, /chat/stream, /agent/chat, /query (LLM-backed)
RATE_LIMIT_UPLOAD=10,5              # POST /documents
RATE_LIMIT_READ=120,30              # everything else authenticated
RATE_LIMIT_IP=300,60                # per client address, before auth (flood backstop)
RATE_LIMIT_AUTHFAIL=10,5            # failed API-key attempts per address; locked-out addresses are refused even with a valid key

LLM_MAX_CONCURRENT=4                # in-flight LLM requests per process; extras wait LLM_QUEUE_WAIT_S then get 503
LLM_QUEUE_WAIT_S=10
METRICS_TOKEN=                      # if set, GET /metrics needs 'Authorization: Bearer <token>'
READY_CACHE_S=5
MAX_RETRIEVAL_DOCUMENTS=1000       # hard cap for an unscoped owner retrieval request
OPENSEARCH_VERIFY_CERTS=true       # required for HTTPS in production; default is true for https:// URLs
