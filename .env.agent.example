# Agent layer (hierarchical tools). Copy lines into .env. No real secrets here; secrets come from the environment.

# --- graph limits (all bounded) ---
AGENT_MAX_TOOL_CALLS_PER_TASK=12
AGENT_MAX_RETRIEVAL_ATTEMPTS=2
AGENT_MAX_LLM_STEPS=4
AGENT_MAX_MODE_CHANGES=2
# Output cap for artifact/visualization drafting calls (ordinary answers keep INFERENCE_MAX_OUTPUT_TOKENS=1000)
AGENT_ARTIFACT_MAX_OUTPUT_TOKENS=2400
AGENT_CAPABILITY_TIMEOUT_S=30

# --- context budget (tokens). Window comes from INFERENCE_MAX_MODEL_LEN; the evidence budget is derived from
#     INFERENCE_* settings (see app/inference/config.py). Compaction starts at ratio * evidence budget. ---
AGENT_EVIDENCE_COMPACTION_RATIO=0.85
AGENT_SAFETY_MARGIN_TOKENS=128
AGENT_TOOL_RESERVE_TOKENS=400
AGENT_SUMMARY_TARGET_TOKENS=700
AGENT_SUMMARY_BATCH_TOKENS=2500
AGENT_SUMMARY_MAX_DEPTH=3

# --- durable state / artifacts ---
# AGENT_STORE_PATH=app/storage/agent.db
# ARTIFACT_DIR=app/storage/artifacts
ARTIFACT_MAX_BYTES=26214400
ARTIFACT_TTL_DAYS=30
FEEDBACK_RETENTION_DAYS=365

# --- web research (opt-in per request via allow_web). Unset = capability reports not_configured ---
# WEB_SEARCH_PROVIDER=searxng            # searxng | brave
# WEB_SEARCH_URL=http://127.0.0.1:8888   # searxng base URL (JSON format must be enabled)
# WEB_SEARCH_API_KEY=                    # brave only; keep in the environment / secret store
WEB_ALLOWED_PORTS=80,443
WEB_MAX_BYTES=2097152
WEB_TIMEOUT_S=10
WEB_MAX_REDIRECTS=4
WEB_ALLOW_PRIVATE_HOSTS=false            # production startup rejects true
INGEST_APPROVAL_TTL_HOURS=24

# --- image generation: any OpenAI-compatible /images/generations endpoint. Unset = not_configured ---
# IMAGE_API_URL=https://example/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=

ANALYSIS_MAX_BYTES=20971520

# --- PDF worker safety limits ---
PDF_MAX_BYTES=104857600
PDF_MAX_PAGES=1000
PDF_MAX_IMAGES_PER_PAGE=1000
PDF_JOB_TIMEOUT_S=900
